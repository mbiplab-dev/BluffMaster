{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/socket.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/socket.io/:path*", "destination": "/api/socket" }
  ],
  "headers": [
    {
      "source": "/socket.io/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
