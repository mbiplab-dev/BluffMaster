# The server reads environment variables supplied by your shell or host.
PORT=3000
BLUFF_DATABASE=.data/bluff.sqlite
VOICE_CHAT=true
# Set the exact HTTPS browser origin when deploying behind a reverse proxy.
# PUBLIC_ORIGIN=https://bluff.example.com
# Optional TURN relay for voice between restrictive networks.
# TURN_URL=turn:your-relay.example.com:3478
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-password
